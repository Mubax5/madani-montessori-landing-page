---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { findNavigationSection } from '../content/school';
import '@fontsource/baskervville/latin-400.css';
import '../styles/global.css';
import '../styles/inner.css';

interface Props {
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? title + ' · Madani Montessori' : 'Madani Montessori';
const currentPath = Astro.url.pathname.replace(/\/?$/, '/');
const isHomepage = currentPath === '/';
const section = findNavigationSection(currentPath);
const sectionLinks = section?.children ? [section, ...section.children] : [];
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true'
  && Astro.response.status !== 404
  && Astro.url.pathname !== '/404.html';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fffcf7" />
    {indexable && Astro.site
      ? <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
      : <meta name="robots" content="noindex, nofollow" />}
    <title>{pageTitle}</title>
  </head>
  <body class:list={[{ 'home-page': isHomepage }]}>
    <a class="skip-link" href="#konten">Lewati ke konten</a>
    <Header />
    <main id="konten" tabindex="-1">
      {section && sectionLinks.length > 0 && (
        <nav class="section-nav" aria-label={'Halaman ' + section.label}>
          <ul class="wrap" role="list">
            {sectionLinks.map((link) => (
              <li><a href={link.href} aria-current={link.href === currentPath ? 'page' : undefined}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      )}
      <slot />
    </main>
    <Footer />
  </body>
</html>
