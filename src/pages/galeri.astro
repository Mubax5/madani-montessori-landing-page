---
import SiteLayout from '../layouts/SiteLayout.astro';
import GalleryCarousel from '../components/GalleryCarousel.astro';
import { galleryIllustrations, galleryPhotos } from '../content/school';

const photos = galleryPhotos.length ? galleryPhotos : galleryIllustrations;
---
<SiteLayout title="Galeri" description="Ruang dan kegiatan belajar Montessori.">
  <section class="wrap gallery-page" aria-labelledby="galeri-judul">
    <h1 id="galeri-judul">Galeri</h1>
    <GalleryCarousel id="galeri-sekolah" {photos} eager />
  </section>
</SiteLayout>
