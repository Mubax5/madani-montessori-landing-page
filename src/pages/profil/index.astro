---
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import InnerMasthead from '../../components/InnerMasthead.astro';
import classroomIllustration from '../../assets/gallery-classroom-illustration.webp';
import { school, schoolMedia } from '../../content/school';

const photo = schoolMedia.profile;
---
<SiteLayout title="Profil Sekolah" description="Kenali Madani Montessori dan pendekatan Montessori Islami.">
  <InnerMasthead title="Mengenal Madani Montessori" tone="sky">
    <figure slot="visual" class="profile-figure">
      <Image
        src={photo?.image ?? classroomIllustration}
        alt={photo?.alt ?? 'Ilustrasi rak rendah berisi alat peraga yang mudah dijangkau anak'}
        widths={[400, 640, 960, 1200]}
        sizes="(min-width: 56rem) 45vw, (min-width: 36rem) 32rem, 90vw"
        format="webp"
        loading="eager"
      />
    </figure>
  </InnerMasthead>
  <section class="section inner-section" aria-labelledby="profil-sekolah">
    <div class="wrap editorial-grid profile-spread">
      <div>
        <h2 id="profil-sekolah">Montessori Islami</h2>
        <p>Di {school.publishedName}, anak belajar dengan alat peraga dan kegiatan sehari-hari. Guru mendampingi saat anak membutuhkannya.</p>
        <p>Anak membiasakan salam, doa, dan sikap menghargai teman. Sekolah dan orang tua bekerja sama untuk melanjutkan kebiasaan itu di rumah.</p>
      </div>
      <nav aria-label="Kenali sekolah">
        <ul class="detail-links" role="list">
          <li><a href="/profil/visi-misi/">Visi &amp; Misi</a></li>
          <li><a href="/metode-montessori/">Metode Montessori</a></li>
          <li><a href="/program/">Program Sekolah</a></li>
        </ul>
      </nav>
    </div>
  </section>
</SiteLayout>
