---
import SiteLayout from '../../layouts/SiteLayout.astro';
import InnerMasthead from '../../components/InnerMasthead.astro';
import ProgramAccordion from '../../components/ProgramAccordion.astro';
import ProgramComparison from '../../components/ProgramComparison.astro';
import { featuredPrograms } from '../../content/school';
---
<SiteLayout title="Program" description="Bandingkan Reguler, Half Day, dan Full Day serta lihat Program Unggulan Madani.">
  <InnerMasthead title="Program" intro="Perbandingan program belajar dan kegiatan yang diperkenalkan Madani Montessori." />
  <section class="section inner-section" aria-labelledby="pilihan-program">
    <div class="wrap program-panel program-panel--overview">
      <div>
        <h2 id="pilihan-program">Pilihan program</h2>
        <a class="text-link" href="/program/program-sekolah/">Rincian jadwal dan kegiatan</a>
      </div>
      <ProgramAccordion />
    </div>
    <div class="wrap program-comparison">
      <details id="perbandingan" class="contact-destination">
        <summary>Bandingkan Program Sekolah <span class="chevron" aria-hidden="true"></span></summary>
        <ProgramComparison />
      </details>
    </div>
  </section>
  <section class="section featured-programs" aria-labelledby="program-unggulan">
    <div class="wrap editorial-grid">
      <div>
        <h2 id="program-unggulan">Program Unggulan</h2>
        <a class="text-link" href="/program/program-unggulan/">Baca Program Unggulan</a>
      </div>
      <ul class="detail-list" role="list">
        {featuredPrograms.map((program) => <li><strong>{program.title}</strong><p>{program.description}</p></li>)}
      </ul>
    </div>
  </section>
</SiteLayout>

<script>
  const comparison = document.querySelector<HTMLDetailsElement>('#perbandingan');
  if (comparison) {
    const openComparison = () => {
      if (window.location.hash === '#perbandingan') comparison.open = true;
    };
    openComparison();
    window.addEventListener('hashchange', openComparison);
  }
</script>
