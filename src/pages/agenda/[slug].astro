---
import SiteLayout from '../../layouts/SiteLayout.astro';
import InnerMasthead from '../../components/InnerMasthead.astro';
import { activities } from '../../content/school';

export function getStaticPaths() {
  return activities.map((activity) => ({ params: { slug: activity.slug }, props: { activity } }));
}

const { activity } = Astro.props;
---
<SiteLayout title={activity.title} description={activity.description}>
  <InnerMasthead title={activity.title} intro={activity.period} parent={{ label: 'Kegiatan', href: '/agenda/' }} />
  <article class="section inner-section">
    <div class="wrap narrow">
      <h2>Catatan dari undangan</h2>
      {activity.sections.map((paragraph) => <p>{paragraph}</p>)}
      <a class="text-link" href="/agenda/">Kembali ke arsip kegiatan</a>
    </div>
  </article>
</SiteLayout>
