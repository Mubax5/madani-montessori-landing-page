---
import SiteLayout from '../layouts/SiteLayout.astro';
import InnerMasthead from '../components/InnerMasthead.astro';
import { admissionsInvitation, school, schoolPrograms } from '../content/school';
---
<SiteLayout title="PPDB" description="Konsultasikan penerimaan peserta didik baru dan tanyakan jadwal kunjungan Madani Montessori.">
  <InnerMasthead title="Penerimaan Peserta Didik" intro={admissionsInvitation} tone="sun" />
  <section class="section inner-section" aria-labelledby="pilihan-program-kunjungan">
    <div class="wrap editorial-grid admissions-options">
      <div>
        <h2 id="pilihan-program-kunjungan">Pilihan program dan kunjungan</h2>
        <p>Dapatkan informasi mengenai pilihan program, persyaratan pendaftaran, dan rencana kunjungan ke sekolah.</p>
        <a class="button" href="/kontak/#konsultasi">Konsultasi Penerimaan</a>
      </div>
      <div class="inset-panel admissions-shortcut">
        <h3>Formulir minat</h3>
        <p>Jika sudah siap, silakan sampaikan minat penerimaan Anda melalui formulir di halaman ini.</p>
        <a class="text-link" href="#formulir-minat">Isi Formulir Minat</a>
      </div>
    </div>
  </section>
  <section id="formulir-minat" class="section admissions-form-section contact-destination" tabindex="-1" aria-labelledby="formulir-title">
    <div class="wrap editorial-grid admissions-form-layout">
      <div>
        <h2 id="formulir-title">Formulir Minat Penerimaan</h2>
        <p id="formulir-penjelasan">Formulir ini menyiapkan pesan WhatsApp ke Madani Montessori. Anda dapat meninjau pesan sebelum mengirimkannya.</p>
      </div>
      <form class="interest-form" data-admissions-form data-whatsapp={school.phone} aria-labelledby="formulir-title" aria-describedby="formulir-penjelasan" hidden>
        <label for="nama-orang-tua">Nama orang tua atau wali <span class="field-note">(wajib)</span></label>
        <input id="nama-orang-tua" name="nama" autocomplete="name" required maxlength="100" pattern={/.*\S.*/.source} />
        <label for="pilihan-program">Program yang diminati</label>
        <select id="pilihan-program" name="program">
          <option value="">Belum menentukan</option>
          {schoolPrograms.map((program) => <option>{program.name}</option>)}
        </select>
        <button class="button" type="submit">Lanjutkan ke WhatsApp</button>
      </form>
      <noscript><a class="text-link" href="/kontak/#konsultasi">Hubungi Madani Montessori untuk menyampaikan minat penerimaan</a></noscript>
    </div>
  </section>
  <section class="section" aria-labelledby="pertanyaan-ppdb">
    <div class="wrap narrow">
      <h2 id="pertanyaan-ppdb">Pertanyaan seputar PPDB</h2>
      <div class="faq-list">
        <details>
          <summary>Bagaimana cara mulai mendaftar?</summary>
          <p>Kami menyarankan <a href="/kontak/#konsultasi">konsultasi penerimaan</a> terlebih dahulu. Jika sudah siap, Anda dapat langsung mengisi <a href="#formulir-minat">formulir minat</a>.</p>
        </details>
        <details>
          <summary>Apa bedanya Reguler, Half Day, dan Full Day?</summary>
          <p>Ketiganya memiliki durasi dan susunan kegiatan yang berbeda. <a href="/program/">Lihat perbandingan program</a>.</p>
        </details>
        <details>
          <summary>Bisakah orang tua berkunjung dulu?</summary>
          <p>Silakan <a href="/kontak/#lokasi">hubungi sekolah untuk informasi kunjungan</a> dan konfirmasi jadwal sebelum datang.</p>
        </details>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-admissions-form]');
  if (form?.dataset.whatsapp) {
    const destination = new URL('https://wa.me/' + form.dataset.whatsapp);
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const fields = new FormData(form);
      const name = String(fields.get('nama') ?? '').trim();
      const program = String(fields.get('program') || 'Belum menentukan');
      destination.searchParams.set('text', [
        'Assalamualaikum, saya ingin menyampaikan minat penerimaan di Madani Montessori.',
        'Nama orang tua/wali: ' + name,
        'Program: ' + program,
      ].join('\n'));
      window.location.assign(destination);
    });
    form.hidden = false;
  }
</script>
