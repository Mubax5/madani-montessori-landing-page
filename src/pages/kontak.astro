---
import SiteLayout from '../layouts/SiteLayout.astro';
import InnerMasthead from '../components/InnerMasthead.astro';
import { school, whatsappLink } from '../content/school';
---
<SiteLayout title="Kontak" description="Hubungi Madani Montessori di Cisauk, Kabupaten Tangerang.">
  <InnerMasthead title="Kontak & Lokasi" intro="Untuk informasi penerimaan atau rencana kunjungan ke sekolah, silakan hubungi kami melalui WhatsApp." />
  <section class="section inner-section">
    <div class="wrap editorial-grid">
      <div id="konsultasi" class="contact-destination">
        <h2>Konsultasi Penerimaan</h2>
        <a class="button" href={whatsappLink('admissions')}>Hubungi Madani Montessori</a>
        <dl class="contact-details">
          <div><dt>WhatsApp</dt><dd>{school.displayPhone}</dd></div>
          <div><dt>Email</dt><dd><a href={'mailto:' + school.email}>{school.email}</a></dd></div>
        </dl>
      </div>
      <div id="lokasi" class="inset-panel contact-destination">
        <h2>Lokasi dan kunjungan</h2>
        <p>{school.location}. Silakan hubungi kami untuk mengatur jadwal kunjungan dan memperoleh petunjuk lokasi.</p>
        <a class="text-link" href={whatsappLink('visit')}>Informasi Kunjungan</a>
      </div>
    </div>
  </section>
</SiteLayout>
