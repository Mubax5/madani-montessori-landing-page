---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import AdmissionsHero from '../components/AdmissionsHero.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeGallery from '../components/HomeGallery.astro';
import ProgramAccordion from '../components/ProgramAccordion.astro';
import materialsIllustration from '../assets/montessori-materials.webp';
import { school, schoolMedia } from '../content/school';
import '../styles/home.css';

const materials = schoolMedia.materials;
---
<SiteLayout description={school.introduction}>
  <HomeHero />

  <section class="section home-intro" aria-labelledby="pendekatan">
    <div class="wrap intro-grid">
      <div class="intro-text">
        <h2 id="pendekatan" tabindex="-1">Montessori Islami dalam keseharian</h2>
        <p>Anak memilih alat belajar, mencoba sendiri, lalu merapikannya kembali. Salam, doa, dan adab dipraktikkan lewat rutinitas di kelas.</p>
        <a class="text-link" href="/metode-montessori/">Kenali metode Montessori</a>
      </div>
      <figure class:list={['study-figure', { 'study-figure--photo': materials }]}>
        <Image
          src={materials?.image ?? materialsIllustration}
          alt={materials?.alt ?? 'Ilustrasi menara merah muda, silinder kayu, dan manik emas Montessori'}
          widths={[420, 680, 960]}
          sizes="(min-width: 54rem) 48vw, 90vw"
          format="webp"
        />
      </figure>
    </div>
  </section>

  <section class="section home-program" aria-labelledby="program-title">
    <div class="wrap program-panel">
      <div>
        <h2 id="program-title">Program sekolah</h2>
        <a class="text-link" href="/program/#perbandingan">Bandingkan program</a>
      </div>
      <ProgramAccordion />
    </div>
  </section>

  <HomeGallery />
  <AdmissionsHero home />
</SiteLayout>
