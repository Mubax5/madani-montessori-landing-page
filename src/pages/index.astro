---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import OrnamentRule from '../components/OrnamentRule.astro';
import ProgramComparison from '../components/ProgramComparison.astro';
import GalleryFigure from '../components/GalleryFigure.astro';
import OrnamentTexture from '../components/OrnamentTexture.astro';
import SectionEdge from '../components/SectionEdge.astro';
import materialsReference from '../assets/montessori-materials-reference.jpg';
import { activities, galleryPhotos, practicalLife, school, schoolMedia, whatsappLink } from '../content/school';

const latestActivity = activities[0];
const featuredPhoto = galleryPhotos[0];
const materials = schoolMedia.materials;
---
<SiteLayout description={school.introduction}>
  <HomeHero />

  <section class="section home-intro" aria-labelledby="intro-title" data-reveal>
    <OrnamentTexture class="intro-texture" drift={8} />
    <div class="wrap intro-grid">
      <h2 id="intro-title">Mengenal<br />Madani Montessori</h2>
      <div class="intro-text">
        <p class="intro-copy">Di Madani Montessori, anak belajar dari benda dan kegiatan yang mereka jumpai sehari-hari. Lingkungan kelas disiapkan supaya anak bisa memilih alat, mencoba sendiri, dan membereskannya kembali. Doa dan adab hadir dalam kebiasaan sehari-hari.</p>
        <OrnamentRule />
        <a class="text-link" href="/profil/">Kenali profil sekolah</a>
      </div>
      <figure class="study-figure">
        <div class="study-image">
          <Image src={materials?.image ?? materialsReference} alt={materials?.alt ?? 'Menara kubus, manik emas, dan tablet warna Montessori dalam pameran'} widths={[420, 680, 960]} sizes="(min-width: 64rem) 40vw, 92vw" format="webp" data-parallax="9" />
        </div>
        {materials
          ? <figcaption>{materials.caption}</figcaption>
          : <figcaption>Contoh alat peraga Montessori · <a href="https://commons.wikimedia.org/wiki/File:Traditional_Montessori_educational_materials.jpg">Nixdorf</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a></figcaption>}
      </figure>
    </div>
  </section>

  <section class="section home-learning" aria-labelledby="learning-title">
    <SectionEdge />
    <OrnamentTexture class="learning-texture" drift={20} />
    <div class="wrap learning-grid" data-reveal>
      <div>
        <h2 id="learning-title">Cara anak belajar di Madani</h2>
        <p>Guru menyiapkan ruang dan alat agar anak bisa mencoba dengan ritmenya sendiri. Saat anak butuh bantuan, guru mendampingi dan memberi kesempatan untuk melanjutkan sendiri.</p>
        <a class="text-link" href="/metode-montessori/">Kenali pendekatan Montessori</a>
      </div>
      <div class="learning-example-home">
        <h3>{practicalLife.title}</h3>
        <p>{practicalLife.summary}</p>
      </div>
    </div>
  </section>

  <section class="home-program" aria-labelledby="program-title" data-reveal>
    <div class="wrap">
      <div class="section-heading">
        <h2 id="program-title">Program Sekolah</h2>
        <a class="text-link" href="/program/">Bandingkan program</a>
      </div>
      <ProgramComparison compact />
    </div>
  </section>

  <div class="wrap home-stories" data-reveal>
    <section aria-labelledby="activity-title">
      <h2 id="activity-title">Kegiatan Sekolah</h2>
      {latestActivity && (
        <article class="home-story">
          <p class="text-note">{latestActivity.period}</p>
          <h3><a href={'/agenda/' + latestActivity.slug + '/'}>{latestActivity.title}</a></h3>
          <p>{latestActivity.description}</p>
        </article>
      )}
      <a class="text-link" href="/agenda/">Lihat arsip kegiatan</a>
    </section>

    <section aria-labelledby="gallery-title" class="story-gallery">
      <h2 id="gallery-title">Galeri</h2>
      {featuredPhoto ? <GalleryFigure photo={featuredPhoto} /> : <p>Foto kegiatan akan ditampilkan setelah disetujui oleh sekolah.</p>}
      <a class="text-link" href="/galeri/">Buka Galeri</a>
    </section>
  </div>

  <section class="section section--admissions" aria-labelledby="admissions-title">
    <div class="wrap admissions-panel" data-reveal>
      <OrnamentTexture class="admissions-texture" drift={12} />
      <div>
        <h2 id="admissions-title">Penerimaan Peserta Didik Baru</h2>
        <p>Konsultasikan pilihan program dengan admin atau tanyakan jadwal kunjungan ke Madani Montessori.</p>
        <div class="admissions-actions">
          <a class="button" href="/ppdb/">Informasi PPDB</a>
          <a class="text-link" href={whatsappLink('visit')}>Tanya jadwal kunjungan</a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-contact" aria-labelledby="contact-title" data-reveal>
    <div class="wrap">
      <h2 id="contact-title">Kontak &amp; Lokasi</h2>
      <div class="home-contact-options">
        <div>
          <h3>Hubungi sekolah</h3>
          <a class="text-link" href={whatsappLink('contact')}>WhatsApp {school.displayPhone}</a>
        </div>
        <div>
          <h3>{school.location}</h3>
          <a class="text-link" href="/kontak/">Informasi lokasi dan kunjungan</a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
