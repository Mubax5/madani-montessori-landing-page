---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import OrnamentRule from '../components/OrnamentRule.astro';
import ProgramComparison from '../components/ProgramComparison.astro';
import HomeGallery from '../components/HomeGallery.astro';
import OrnamentTexture from '../components/OrnamentTexture.astro';
import SectionEdge from '../components/SectionEdge.astro';
import materialsIllustration from '../assets/montessori-materials.webp';
import { admissionsInvitation, school, schoolMedia } from '../content/school';

const materials = schoolMedia.materials;
---
<SiteLayout description={school.introduction}>
  <HomeHero />

  <section class="section home-intro" aria-labelledby="intro-title" data-reveal>
    <OrnamentTexture class="intro-texture" drift={8} />
    <div class="wrap intro-grid">
      <h2 id="intro-title">Mengenal<br />Madani Montessori</h2>
      <div class="intro-text">
        <p class="intro-copy">Di Madani Montessori, anak belajar dari benda dan kegiatan yang mereka jumpai sehari-hari. Lingkungan kelas disiapkan supaya anak bisa memilih alat, mencoba sendiri, dan membereskannya kembali. Doa dan adab hadir dalam kebiasaan sehari-hari.</p>
        <OrnamentRule />
        <a class="text-link" href="/profil/">Kenali profil sekolah</a>
      </div>
      <figure class="study-figure">
        <div class="study-image">
          <Image src={materials?.image ?? materialsIllustration} alt={materials?.alt ?? 'Ilustrasi menara merah muda, silinder kayu, dan manik emas Montessori'} widths={[420, 680, 960]} sizes="(min-width: 44rem) 44vw, 90vw" format="webp" data-parallax="9" />
        </div>
        {materials && <figcaption>{materials.caption}</figcaption>}
      </figure>
    </div>
  </section>

  <section class="home-program" aria-labelledby="program-title">
    <SectionEdge />
    <OrnamentTexture class="program-texture" />
    <div class="wrap" data-reveal>
      <h2 id="program-title">Program Sekolah</h2>
      <ProgramComparison compact />
      <a class="text-link program-link" href="/program/#perbandingan">Bandingkan Program</a>
    </div>
    <SectionEdge edge="bottom" />
  </section>

  <HomeGallery />

  <section class="admissions-panel" aria-labelledby="admissions-title">
    <SectionEdge />
    <OrnamentTexture class="admissions-texture" drift={12} />
    <div class="wrap" data-reveal>
      <h2 id="admissions-title">Penerimaan Peserta Didik</h2>
      <p>{admissionsInvitation}</p>
      <a class="button" href="/kontak/#konsultasi">Konsultasi Penerimaan</a>
    </div>
    <SectionEdge edge="bottom" />
  </section>

  <section class="home-contact" aria-labelledby="contact-title" data-reveal>
    <div class="wrap home-contact-options">
      <div>
        <h2 id="contact-title">Kontak &amp; Lokasi</h2>
        <p>Untuk informasi penerimaan atau rencana kunjungan ke sekolah, silakan hubungi kami melalui WhatsApp.</p>
        <a class="button" href="/kontak/#konsultasi">Hubungi Madani Montessori</a>
      </div>
      <div>
        <h3>{school.location}</h3>
        <a class="text-link" href="/kontak/#lokasi">Lihat Lokasi</a>
      </div>
    </div>
  </section>
</SiteLayout>
