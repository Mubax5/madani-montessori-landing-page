---
import { schoolPrograms } from '../content/school';

const criteria = [
  { key: 'hours', label: 'Jam belajar' },
  { key: 'scope', label: 'Cakupan' },
  { key: 'activities', label: 'Kegiatan' },
  { key: 'meals', label: 'Layanan makan' },
] as const;
---
<table class="comparison">
  <caption class="visually-hidden">Perbandingan Reguler, Half Day, dan Full Day</caption>
  <thead>
    <tr>
      {schoolPrograms.map((program, index) => (
        <th scope="col" id={'program-kolom-' + index} data-comparison-program={program.name}>{program.name}</th>
      ))}
    </tr>
  </thead>
  {criteria.map(({ key, label }) => (
    <tbody>
      <tr><th id={'program-kriteria-' + key} scope="rowgroup" colspan={schoolPrograms.length}>{label}</th></tr>
      <tr>
        {schoolPrograms.map((program, index) => (
          <td headers={'program-kolom-' + index + ' program-kriteria-' + key} data-comparison-program={program.name}>
            {key === 'hours'
              ? <><span class="program-hours">{program.hours}</span> <span class="time-zone">WIB</span></>
              : program[key]}
          </td>
        ))}
      </tr>
    </tbody>
  ))}
</table>
<p class="comparison-note text-note">Jam makan dan jumlah makan untuk semua program masih perlu dikonfirmasi.</p>
