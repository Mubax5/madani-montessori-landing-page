---
import { Image } from 'astro:assets';
import logo from '../assets/logo-madani.png';
import { findNavigationSection, navigation } from '../content/school';

const currentPath = Astro.url.pathname.replace(/\/?$/, '/');
const currentSection = findNavigationSection(currentPath);
const mainNavigation = navigation.filter((item) => item.href !== '/' && item.href !== '/agenda/');
---
<header class="site-header" data-site-header>
  <div class="header-inner">
    <a class="brand header-brand" href="/" aria-label="Madani Montessori, Beranda" aria-current={currentPath === '/' ? 'page' : undefined}>
      <Image src={logo} alt="" width={72} height={72} />
      <span class="brand-wordmark">Madani<br />Montessori</span>
    </a>
    <button class="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="main-nav" hidden>
      Menu <span class="chevron" aria-hidden="true"></span>
    </button>
    <nav id="main-nav" class="main-nav" aria-label="Navigasi utama">
      <ul class="nav-list">
        {mainNavigation.map((item) => {
          const active = currentPath === item.href;
          const sectionActive = item === currentSection;
          return (
            <li class:list={['nav-item', { 'is-active': sectionActive, 'nav-item--admissions': item.href === '/ppdb/' }]}>
              <div class="nav-label">
                <a href={item.href} aria-current={active ? 'page' : undefined}>{item.label}</a>
              </div>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menu = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  function isExpanded(button: HTMLButtonElement) {
    return button.getAttribute('aria-expanded') === 'true';
  }

  function setExpanded(button: HTMLButtonElement, value: boolean) {
    button.setAttribute('aria-expanded', String(value));
  }

  if (header && menu) {
    const closeNavigation = () => {
      setExpanded(menu, false);
    };

    header.dataset.ready = '';
    menu.hidden = false;
    menu.addEventListener('click', () => {
      setExpanded(menu, !isExpanded(menu));
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Node && !header.contains(target)) closeNavigation();
    });

    header.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && !header.contains(event.relatedTarget)) {
        closeNavigation();
      }
    });

    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isExpanded(menu)) {
        closeNavigation();
        menu.focus();
      }
    });

    const wideLayout = window.matchMedia('(min-width: 64rem)');
    wideLayout.addEventListener('change', closeNavigation);
  }
</script>
