---
import { Image } from 'astro:assets';
import learningIllustration from '../assets/hero-learning.webp';
import { schoolMedia } from '../content/school';
import OrnamentRule from './OrnamentRule.astro';
import OrnamentTexture from './OrnamentTexture.astro';

const photo = schoolMedia.hero;
const heroImage = photo?.image ?? learningIllustration;
---
<section class="home-hero" aria-labelledby="home-title">
  <div class="hero-figure" aria-hidden="true">
    <Image
      src={heroImage}
      class="hero-photo"
      style={photo?.position ? { objectPosition: photo.position } : undefined}
      data-parallax="14"
      alt=""
      widths={[520, 900, 1400, 1700]}
      sizes="100vw"
      format="webp"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <OrnamentTexture class="hero-texture" drift={12} />
  <div class="hero-title-block">
    <div class="hero-frame" aria-hidden="true">
    <svg class="hero-arch" viewBox="0 0 540 209" fill="none">
      <defs>
        <linearGradient id="arch-ink">
          <stop offset="0" stop-color="currentColor" stop-opacity="0" />
          <stop offset=".25" stop-color="currentColor" stop-opacity=".55" />
          <stop offset=".75" stop-color="currentColor" stop-opacity=".55" />
          <stop offset="1" stop-color="currentColor" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path d="M1 205C13 157 48 117 108 118C127 64 157 48 203 37C235 30 257 18 270 2C283 18 305 30 337 37C383 48 413 64 432 118C492 117 527 157 539 205" stroke="url(#arch-ink)" stroke-width="1.1" vector-effect="non-scaling-stroke" />
    </svg>
    </div>
    <h1 id="home-title"><span>Madani</span> <span>Montessori</span></h1>
    <OrnamentRule />
  </div>
  <svg class="hero-divider" viewBox="0 0 1536 53" preserveAspectRatio="none" fill="none" aria-hidden="true">
    <path d="M0 5H175C215 5 232 11 260 27C286 42 309 50 341 50H1197C1230 50 1253 42 1279 27C1307 11 1324 5 1364 5H1536V53H0Z" class="divider-paper" />
    <path d="M0 5H175C215 5 232 11 260 27C286 42 309 50 341 50H1197C1230 50 1253 42 1279 27C1307 11 1324 5 1364 5H1536" stroke="currentColor" stroke-width="1.6" vector-effect="non-scaling-stroke" />
  </svg>
</section>
