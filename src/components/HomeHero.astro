---
import { Image } from 'astro:assets';
import learningIllustration from '../assets/hero-learning.webp';
import { schoolMedia } from '../content/school';
import OrnamentRule from './OrnamentRule.astro';

const photo = schoolMedia.hero;
const heroImage = photo?.image ?? learningIllustration;
---
<section class="home-hero" aria-labelledby="home-title" data-background-parallax="18">
  <div class="hero-figure" aria-hidden="true">
    <Image
      src={heroImage}
      class="hero-photo"
      style={photo?.position ? { objectPosition: photo.position } : undefined}
      data-parallax="14"
      alt=""
      widths={[520, 900, 1400, 1700]}
      sizes="100vw"
      format="webp"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="hero-title-block">
    <h1 id="home-title">
      <span class="hero-school-level">TK IT</span>
      <span>Madani</span> <span>Montessori</span>
    </h1>
    <OrnamentRule />
    <p class="hero-greeting">Assalamualaikum</p>
  </div>
  <svg class="hero-divider" viewBox="0 0 1536 53" preserveAspectRatio="none" fill="none" aria-hidden="true">
    <path d="M0 5H175C215 5 232 11 260 27C286 42 309 50 341 50H1197C1230 50 1253 42 1279 27C1307 11 1324 5 1364 5H1536V53H0Z" class="divider-paper" />
    <path d="M0 5H175C215 5 232 11 260 27C286 42 309 50 341 50H1197C1230 50 1253 42 1279 27C1307 11 1324 5 1364 5H1536" stroke="currentColor" stroke-width="1.6" vector-effect="non-scaling-stroke" />
  </svg>
</section>
