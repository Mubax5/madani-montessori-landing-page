---
import { Image } from 'astro:assets';
import pouringIllustration from '../assets/gallery-practical-life-illustration.webp';
import { practicalLife, schoolMedia } from '../content/school';

const photo = schoolMedia.practicalLife;
---
<aside class="learning-example" aria-labelledby="contoh-practical-life">
  <figure>
    <Image
      src={photo?.image ?? pouringIllustration}
      alt={photo?.alt ?? 'Ilustrasi anak berlatih menuang air dari kendi kecil ke gelas di atas baki'}
      widths={[400, 640, 960, 1200]}
      sizes="(min-width: 56rem) 51vw, (min-width: 36rem) 32rem, 90vw"
      format="webp"
    />
  </figure>
  <div class="learning-example-copy">
    <h2 id="contoh-practical-life">{practicalLife.title}</h2>
    <p>{practicalLife.summary}</p>
  </div>
</aside>
