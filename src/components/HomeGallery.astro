---
import { Image } from 'astro:assets';
import learningIllustration from '../assets/hero-learning.webp';
import { galleryIllustrations, galleryPhotos, type GalleryPhoto } from '../content/school';

const workWithMaterials: GalleryPhoto = {
  image: learningIllustration,
  alt: 'Anak memasang silinder kayu dan menyusun menara merah muda',
  caption: 'Belajar dengan alat peraga',
  description: 'Silinder kayu dan menara merah muda adalah contoh material yang dapat dipilih dan dikembalikan anak ke tempatnya.',
  category: 'Ilustrasi',
};
const isIllustration = galleryPhotos.length === 0;
const photos = isIllustration
  ? [galleryIllustrations[0], workWithMaterials]
  : galleryPhotos.slice(0, 2);
---
<section class="section home-gallery" aria-labelledby="gallery-title" data-home-gallery>
  <div class="wrap">
    <div class="gallery-heading">
      <h2 id="gallery-title">Galeri &amp; kegiatan</h2>
      <div class="home-actions">
        <a class="text-link" href="/galeri/">Lihat galeri</a>
        <a class="text-link" href="/agenda/">Lihat arsip kegiatan</a>
      </div>
    </div>
    <div class:list={['gallery-spread', { 'gallery-spread--single': photos.length === 1 }]}>
      {photos.map((photo, index) => (
        <figure class="home-gallery-figure">
          <a
            class="gallery-photo-link"
            href={photo.image.src}
            aria-label={`Perbesar ${isIllustration ? 'ilustrasi' : 'foto'}: ${photo.caption}`}
            data-gallery-photo
            data-title={photo.caption}
            data-description={photo.description ?? photo.alt}
          >
            <Image
              src={photo.image}
              alt={photo.alt}
              widths={[400, 640, 960, 1200]}
              sizes={index === 0 ? '(min-width: 54rem) 58vw, 90vw' : '(min-width: 54rem) 29vw, 85vw'}
              format="webp"
            />
            <span class="gallery-expand">Perbesar</span>
          </a>
          <figcaption>{isIllustration && 'Ilustrasi sementara · '}{photo.caption}</figcaption>
        </figure>
      ))}
    </div>
    <dialog class="gallery-dialog" data-gallery-dialog aria-labelledby="gallery-photo-title" aria-describedby="gallery-photo-description">
      <button class="gallery-close" type="button" autofocus aria-label="Tutup gambar">Tutup</button>
      <img data-dialog-image src={photos[0].image.src} alt="" loading="lazy" />
      <div class="gallery-dialog-copy">
        <h3 id="gallery-photo-title"></h3>
        {isIllustration && <p class="media-caption">Ilustrasi sementara</p>}
        <p id="gallery-photo-description"></p>
      </div>
    </dialog>
  </div>
</section>

<script>
  import '../scripts/home-gallery';
</script>
