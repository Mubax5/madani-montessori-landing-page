---
import GalleryCarousel from './GalleryCarousel.astro';
import { galleryIllustrations, galleryPhotos } from '../content/school';

const photos = (galleryPhotos.length ? galleryPhotos : galleryIllustrations).slice(0, 4);
---
<section class="section home-gallery" aria-labelledby="gallery-title">
  <div class="wrap">
    <div class="gallery-heading">
      <h2 id="gallery-title">Galeri</h2>
      <a class="text-link" href="/galeri/">Lihat galeri</a>
    </div>
    <GalleryCarousel id="galeri-beranda" {photos} />
  </div>
</section>
